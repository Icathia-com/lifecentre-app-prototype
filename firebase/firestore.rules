rules_version = '2';

// Life Centre app: Firestore security rules.
// Public: read published announcements and events, read verses.
// Staff and admin (an email in /staff with that role, signed in with a verified Google account): write them.
// Leader (also in /staff): can be recognised by the app, but cannot post or read drafts.
// Videos (Watch): public read; admins and leaders post and edit; any staff-list member (admin, staff or leader) can remove one.
// Pop-ups: everyone reads the one live pop-up; staff send requests; admins and people with "Can approve pop-ups" decide.
// Admin: also manage /staff. Everything not listed here (stories for now) is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(userEmail());
    }

    function isStaff() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(staffPath());
    }

    function role() {
      return get(staffPath()).data.role;
    }

    function isAdmin() {
      return isStaff() && role() == 'admin';
    }

    // Who may post announcements, verses and events, and read unpublished drafts: admins and staff.
    // Leaders are on the staff list (they get the Facilities Booking tab) but cannot post.
    function canPublish() {
      return isStaff() && role() in ['admin', 'staff'];
    }

    // Who may post videos in Watch: admins and organisation leaders (not plain staff).
    function canPostVideo() {
      return isStaff() && role() in ['admin', 'leader'];
    }

    // A permission switch an admin can set on a staff entry, e.g. approvePopups.
    function hasSwitch(key) {
      return isStaff() && get(staffPath()).data.get(key, false) == true;
    }

    // Who decides on launch pop-ups: admins, and anyone on the staff list with "Can approve pop-ups".
    function canApprovePopups() {
      return isAdmin() || hasSwitch('approvePopups');
    }

    function configPath() {
      return /databases/$(database)/documents/config/app;
    }

    // The id of the pop-up in the live slot ('' when there is none).
    function livePopupId() {
      return exists(configPath()) ? get(configPath()).data.get('livePopupId', '') : '';
    }

    function isText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function optionalText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validAnnouncement(d) {
      return d.keys().hasOnly(['title', 'body', 'pinned', 'published', 'publishedAt', 'expiresAt',
                               'linkUrl', 'linkLabel', 'sample', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'body', 'pinned', 'published', 'publishedAt', 'updatedBy'])
        && isText(d.title, 120)
        && d.body is string && d.body.size() <= 4000
        && d.pinned is bool
        && d.published is bool
        && d.publishedAt is timestamp
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && (!('linkUrl' in d) || (d.linkUrl is string && d.linkUrl.matches('^https://.{1,490}$')))
        && optionalText(d, 'linkLabel', 40)
        && (!('sample' in d) || d.sample is bool)
        && d.updatedBy == userEmail();
    }

    // A scheduled verse is a passage, never more than 25 verses: passageId is USFM ("JHN.3.16" or "JHN.3.16-17") and reference is
    // its English name ("John 3:16-17"). The text comes from the daily job (votd), not from here.
    function passageVerses(id) {
      let verses = id.split('[.]')[2].split('-');
      return verses.size() == 1 ? 1 : int(verses[1]) - int(verses[0]) + 1;
    }

    function validVerse(d) {
      return d.keys().hasOnly(['passageId', 'reference', 'sample', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['passageId', 'reference', 'updatedBy'])
        && d.passageId is string
        && d.passageId.matches('^[1-3A-Z][A-Z0-9]{2}[.][0-9]{1,3}[.][0-9]{1,3}(-[0-9]{1,3})?$')
        && passageVerses(d.passageId) >= 1
        && passageVerses(d.passageId) <= 25
        && isText(d.reference, 60)
        && (!('sample' in d) || d.sample is bool)
        && d.updatedBy == userEmail();
    }

    // An event cover: two colours and a short label, and optionally a small JPEG photo kept inside the event.
    function validCover(c) {
      return c is map
        && c.keys().hasOnly(['from', 'to', 'label', 'photo'])
        && c.keys().hasAll(['from', 'to', 'label'])
        && c.from is string && c.from.matches('^#[0-9A-Fa-f]{6}$')
        && c.to is string && c.to.matches('^#[0-9A-Fa-f]{6}$')
        && c.label is string && c.label.size() <= 40
        && (!('photo' in c) || (c.photo is string && c.photo.size() > 23 && c.photo.size() <= 140000
                                 && c.photo[0:23] == 'data:image/jpeg;base64,'));
    }

    // `location` is one of the four sites (or "other", with the venue in `place`); `type` is one of the six event types.
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'start', 'end', 'allDay', 'location', 'place', 'type', 'host', 'description',
                               'cover', 'pinned', 'registerUrl', 'requireApproval', 'price', 'capacity', 'notifyFollowers',
                               'going', 'published', 'sample', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'start', 'location', 'type', 'published', 'updatedBy'])
        && isText(d.title, 120)
        && d.start is timestamp
        && (!('end' in d) || (d.end is timestamp && d.end >= d.start))
        && (!('allDay' in d) || d.allDay is bool)
        && d.location in ['yishun', 'tuas', 'kranji', 'pasir', 'other']
        && optionalText(d, 'place', 120)
        && d.type in ['service', 'kids', 'youth', 'cell', 'prayer', 'special']
        && optionalText(d, 'host', 80)
        && optionalText(d, 'description', 2000)
        && (!('cover' in d) || validCover(d.cover))
        && (!('pinned' in d) || d.pinned is bool)
        && (!('registerUrl' in d) || (d.registerUrl is string && d.registerUrl.matches('^https://.{1,490}$')))
        && (!('requireApproval' in d) || d.requireApproval is bool)
        && (!('price' in d) || (d.price is int && d.price > 0 && d.price <= 100000))
        && (!('capacity' in d) || (d.capacity is int && d.capacity > 0 && d.capacity <= 100000))
        && (!('notifyFollowers' in d) || d.notifyFollowers is bool)
        && (!('going' in d) || (d.going is int && d.going >= 0))
        && d.published is bool
        && (!('sample' in d) || d.sample is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && d.updatedBy == userEmail();
    }

    // A Watch video is a YouTube video (`videoId`, the 11-character id; `url` is the link rebuilt from it) or, later, an uploaded file.
    // `dur` is the length in seconds. Nothing here is a draft: a video is public as soon as it is saved.
    function validVideo(d) {
      return d.keys().hasOnly(['title', 'org', 'desc', 'src', 'videoId', 'url', 'dur', 'sample', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'src', 'updatedBy'])
        && isText(d.title, 120)
        && optionalText(d, 'org', 40)
        && optionalText(d, 'desc', 300)
        && d.src in ['youtube', 'upload']
        && (d.src != 'youtube' || ('videoId' in d && d.videoId is string && d.videoId.matches('^[A-Za-z0-9_-]{11}$')))
        && (!('videoId' in d) || (d.videoId is string && d.videoId.matches('^[A-Za-z0-9_-]{11}$')))
        && (!('url' in d) || (d.url is string && d.url.matches('^https://.{1,490}$')))
        && (!('dur' in d) || (d.dur is int && d.dur > 0 && d.dur <= 14400))
        && (!('sample' in d) || d.sample is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && d.updatedBy == userEmail();
    }

    function validStaff(d) {
      return d.keys().hasOnly(['role', 'name', 'approvePopups', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['role', 'updatedBy'])
        && d.role in ['admin', 'leader', 'staff']
        && optionalText(d, 'name', 80)
        && (!('approvePopups' in d) || d.approvePopups is bool)
        && d.updatedBy == userEmail();
    }

    // config/app: the pop-up master switch (off until an admin turns it on) and the id of the one pop-up in the live slot.
    function validConfig(d) {
      return d.keys().hasOnly(['popupsOn', 'livePopupId', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['popupsOn', 'updatedBy'])
        && d.popupsOn is bool
        && (!('livePopupId' in d) || d.livePopupId == null || isText(d.livePopupId, 100))
        && d.updatedBy == userEmail();
    }

    // A pop-up banner: an https address in the church's storage, or (a request made from an event) the event's own small JPEG.
    function validPopupImage(p) {
      return p is string
        && ((p.size() <= 500 && p.matches('^https://.{1,490}$'))
            || (p.size() > 23 && p.size() <= 140000 && p[0:23] == 'data:image/jpeg;base64,'));
    }

    function validPopup(d) {
      return d.keys().hasOnly(['title', 'image', 'eventId', 'start', 'end', 'status', 'requestedBy', 'approvedBy', 'note',
                               'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'image', 'start', 'end', 'status', 'requestedBy', 'updatedBy'])
        && isText(d.title, 80)
        && validPopupImage(d.image)
        && optionalText(d, 'eventId', 100)
        && d.start is timestamp
        && d.end is timestamp && d.end > d.start
        && d.status in ['draft', 'requested', 'approved', 'live', 'ended', 'declined']
        && isText(d.requestedBy, 120)
        && optionalText(d, 'approvedBy', 120)
        && optionalText(d, 'note', 300)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && d.updatedBy == userEmail();
    }

    // Nobody approves their own request, admins included.
    function approvingOwnPopup() {
      return resource.data.status == 'requested'
        && request.resource.data.status in ['approved', 'live']
        && resource.data.requestedBy == userEmail();
    }

    // Public queries must filter on published == true, or the read is refused.
    match /announcements/{id} {
      allow read: if resource.data.published == true || canPublish();
      allow create, update: if canPublish() && validAnnouncement(request.resource.data);
      allow delete: if canPublish();
    }

    // The document id is the date, e.g. 2026-10-27.
    match /verses/{date} {
      allow read: if true;
      allow create, update: if canPublish()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validVerse(request.resource.data);
      allow delete: if canPublish();
    }

    // The day's Bible text in each version, written by the daily job (it runs as the project owner, which the rules do not limit).
    // The document id is the date. No app account can write here.
    match /votd/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{id} {
      allow read: if resource.data.published == true || canPublish();
      allow create, update: if canPublish() && validEvent(request.resource.data);
      allow delete: if canPublish();
    }

    match /videos/{id} {
      allow read: if true;
      allow create, update: if canPostVideo() && validVideo(request.resource.data);
      allow delete: if isStaff();
    }

    // The document id is the lower-case email address.
    match /staff/{email} {
      allow get: if isAdmin() || (signedIn() && email == userEmail());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && validStaff(request.resource.data);
      allow delete: if isAdmin() && email != userEmail();
    }

    // One document. Admins set the master switch; admins and approvers change which pop-up is live (an approver may create
    // the document, but only with the switch off).
    match /config/app {
      allow read: if true;
      allow create: if validConfig(request.resource.data)
        && (isAdmin() || (canApprovePopups() && request.resource.data.popupsOn == false));
      allow update: if validConfig(request.resource.data)
        && (isAdmin()
            || (canApprovePopups()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['livePopupId', 'updatedBy', 'updatedAt'])));
      allow delete: if false;
    }

    // Launch pop-ups. Everyone may read the one in the live slot; staff who post, and approvers, read them all.
    // Staff create requests in their own name (admins may also save drafts and make a pop-up live straight away).
    // Approvers approve, decline or end a pop-up, never their own request, and change nothing else about it.
    // A requester may edit their own request while it is still a draft, a request, or declined.
    match /popups/{id} {
      allow get: if canPublish() || canApprovePopups()
        || (resource.data.status in ['approved', 'live'] && id == livePopupId());
      allow list: if canPublish() || canApprovePopups();
      allow create: if validPopup(request.resource.data)
        && request.resource.data.requestedBy == userEmail()
        && (isAdmin() || (canPublish() && request.resource.data.status in ['draft', 'requested']));
      allow update: if validPopup(request.resource.data)
        && !approvingOwnPopup()
        && (isAdmin()
            || (canApprovePopups()
                && resource.data.requestedBy != userEmail()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'note', 'updatedBy', 'updatedAt'])
                && request.resource.data.status in ['approved', 'live', 'declined', 'ended']
                && (request.resource.data.get('approvedBy', '') == userEmail()
                    || (resource.data.status in ['approved', 'live']
                        && request.resource.data.get('approvedBy', '') == resource.data.get('approvedBy', ''))))
            || (canPublish()
                && resource.data.requestedBy == userEmail()
                && resource.data.status in ['draft', 'requested', 'declined']
                && request.resource.data.status in ['draft', 'requested']));
      allow delete: if isAdmin()
        || (canPublish() && resource.data.requestedBy == userEmail() && resource.data.status != 'live');
    }
  }
}
